{
  "name": "dotabukva",
  "version": "1.1.0",
  "private": true,
  "description": "DOTA-BUKVA — spin, describe, guess (web + Electron desktop)",
  "author": "mrmdkkkk",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite --mode electron\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "tsc -b && vite build --mode electron && electron-builder",
    "electron:build:linux": "tsc -b && vite build --mode electron && electron-builder --linux",
    "electron:build:win": "tsc -b && vite build --mode electron && electron-builder --win",
    "electron:pack": "tsc -b && vite build --mode electron && electron-builder --dir",
    "rooms:dev": "npm --prefix cloudflare run dev",
    "rooms:deploy": "npm --prefix cloudflare run deploy",
    "test": "node --experimental-strip-types --import ./test/register.mjs --test test electron && npm --prefix cloudflare test"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "styled-components": "^6.4.3",
    "vite": "^8.1.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.dotabukva.app",
    "productName": "DOTA-BUKVA",
    "copyright": "Copyright © mrmdkkkk",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "icon": "electron/resources/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "linux": {
      "icon": "electron/resources/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "mrmdkkkk"
    },
    "win": {
      "icon": "electron/resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DOTA-BUKVA"
    },
    "mac": {
      "icon": "electron/resources/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    }
  }
}
